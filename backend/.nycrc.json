{
  "all": true,
  "check-coverage": true,
  "reporter": [
    "text",
    "text-summary",
    "html",
    "lcov",
    "json"
  ],
  "include": [
    "index.js",
    "functions/**/*.js",
    "middleware/**/*.js",
    "routes/**/*.js"
  ],
  "exclude": [
    "tests/**",
    "node_modules/**",
    "coverage/**",
    "*.config.js",
    "*.test.js",
    "test/**",
    ".nyc_output/**"
  ],
  "extension": [
    ".js"
  ],
  "cache": true,
  "temp-dir": "./.nyc_output",
  "report-dir": "./coverage",
  "branches": 80,
  "lines": 80,
  "functions": 80,
  "statements": 80,
  "per-file": true,
  "skip-full": false,
  "produce-source-map": true,
  "instrument": true,
  "source-map": true
} 