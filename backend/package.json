{
  "name": "localseva-backend",
  "version": "1.0.0",
  "description": "LocalSeva Backend - Firebase Functions for vendor search and booking management",
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "mocha tests/**/*.test.js --recursive --timeout 10000",
    "test:watch": "mocha tests/**/*.test.js --recursive --watch --timeout 10000",
    "test:coverage": "nyc mocha tests/**/*.test.js --recursive --timeout 10000",
    "test:frontend": "cd ../frontend && npm test",
    "test:all": "npm test && npm run test:frontend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "node": "18"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.8.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "axios": "^1.6.0",
    "geofire-common": "^6.0.0",
    "moment": "^2.29.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.1.0",
    "mocha": "^10.2.0",
    "chai": "^4.3.10",
    "sinon": "^17.0.1",
    "supertest": "^6.3.3",
    "nyc": "^15.1.0"
  },
  "private": true,
  "keywords": [
    "firebase",
    "functions",
    "localseva",
    "vendor",
    "booking",
    "whatsapp"
  ],
  "author": "LocalSeva Team",
  "license": "MIT"
} 